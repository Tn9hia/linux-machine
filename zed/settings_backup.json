// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "languages": {
    "YAML": {
      "show_edit_predictions": false
    }
  },
  "tab_size": 2,
  "indent_guides": {
    "background_coloring": "disabled"
  },
  "tabs": {
    "git_status": false,
    "file_icons": true
  },
  "restore_on_startup": "last_workspace",
  "completions": {
    "words": "fallback"
  },
  "inlay_hints": {
    "enabled": true,
    "show_background": false
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": false
  },
  "project_panel": {
    "dock": "right",
    "button": true
  },
  "terminal": {
    "cursor_shape": "block",
    "copy_on_select": true,
    "blinking": "terminal_controlled",
    "toolbar": {
      "breadcrumbs": false
    },
    "font_family": ".ZedMono"
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager"
  },
  "hard_tabs": false,
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "soft_wrap": "editor_width",
  "toolbar": {
    "code_actions": true
  },
  "ui_font_weight": 400.0,
  "disable_ai": false,
  "agent": {
    "dock": "left",
    "play_sound_when_agent_done": true,
    "profiles": {
      "agent": {
        "default_model": {
          "provider": "google",
          "model": "gemini-3-pro-preview"
        },
        "name": "agent",
        "tools": {
          "delete_path": true,
          "create_directory": true,
          "read_file": true,
          "open": true,
          "now": true,
          "move_path": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "copy_path": true,
          "terminal": true,
          "thinking": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest"
    },
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "codegemma:2b"
    },
    "model_parameters": []
  },
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "file_types": {
    "terraform": [
      "*.tf"
    ]
  },
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Mirage"
  }
}
